# AI Engineering Team - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# GROQ API CONFIGURATION
# ============================================================
# Get your API key from: https://console.groq.com
# Required for real AI agent execution (optional for demo mode)
GROQ_API_KEY=

# Model selection (optional - defaults shown)
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ============================================================
# BUDGET CONFIGURATION
# ============================================================
# Maximum budget per project (in EUR)
DEFAULT_PROJECT_BONUS=25.0

# Maximum budget per task (in EUR)
DEFAULT_TASK_BONUS=5.0

# Currency for cost tracking
DEFAULT_CURRENCY=EUR

# ============================================================
# AUTONOMY LEVELS
# ============================================================
# 0 = Analysis only
# 1 = Analysis + planning
# 2 = Implementation allowed
# 3 = Implementation + PR creation (default)
# 4 = Staging deployment
# 5 = Highly autonomous
DEFAULT_AUTONOMY_LEVEL=3

# ============================================================
# GITHUB INTEGRATION (Optional)
# ============================================================
# For creating real pull requests
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# IndexedDB database name
DB_NAME=ai-engineering-team

# IndexedDB version
DB_VERSION=1

# ============================================================
# LOGGING
# ============================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging
VERBOSE_LOGGING=false

# ============================================================
# SECURITY
# ============================================================
# Enable CORS (for development)
ENABLE_CORS=true

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable analytics tracking
ENABLE_ANALYTICS=true

# Enable error tracking
ENABLE_ERROR_TRACKING=false
